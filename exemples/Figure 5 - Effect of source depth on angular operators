function IAF_Figura5_Profundidade()
% IAF_Figura5_Profundidade.m
% Figure 5: controlled test of source-depth effects on ISA, Theta and IAF.
% Independent script; does not modify earlier IAF scripts.
% Three clean-field scenarios. Both prisms are translated downward while
% their dimensions, lateral positions, discretization, and physical
% parameters remain unchanged.
%
% Run in GNU Octave or MATLAB:
%   IAF_Figura5_Profundidade
%
% Outputs:
%   IAF_Figura5_Profundidade.png
%   IAF_Figura5_Profundidade_Data.mat

clear; close all; clc;

%% 1. Observation grid and fixed parameters (consistent with Figure 4)
dxObs = 10; dyObs = 10;
xObs = -500:dxObs:500;
yObs = -200:dyObs:200;
[Xobs,Yobs] = meshgrid(xObs,yObs);

inclination = 45;
declination = 0;
M = 1;
mu0_over_4pi = 1e-7;
epsilon = 1e-6;
zTop = -5; zObs = 0; zBottom = 5;

incRad = inclination*pi/180;
decRad = declination*pi/180;
mHat = [cos(incRad)*cos(decRad), cos(incRad)*sin(decRad), sin(incRad)];
fHat = mHat; % same assumption as Figure 4

%% 2. Three depth scenarios: exact Figure 4 geometry, then +50 and +100 m
scenarioNames = {'A: reference','B: +50 m','C: +100 m'};
depthShifts = [0 50 100];

shallowBase.x = [-300 -120];
shallowBase.y = [-60 60];
shallowBase.z = [70 150];
shallowBase.n = [9 6 6];

deepBase.x = [220 500];
deepBase.y = [-90 90];
deepBase.z = [220 360];
deepBase.n = [14 9 8];

trueContacts = [shallowBase.x(1), shallowBase.x(2), ...
                deepBase.x(1), deepBase.x(2)];
minPeakSeparation = 30;      % m
associationTolerance = 50;   % m

nS = numel(depthShifts);
ISA_all = cell(1,nS);
Theta_all = cell(1,nS);
IAF_all = cell(1,nS);
T_all = cell(1,nS);
shallowAll = cell(1,nS);
deepAll = cell(1,nS);
allPeakPositions = cell(3,nS);
estimatedContacts = NaN(3,nS,numel(trueContacts));
contactErrors = NaN(3,nS,numel(trueContacts));
detectionRates = NaN(3,nS);
meanErrors = NaN(3,nS);

%% 3. Forward model and operators for each depth scenario
for s = 1:nS
    shallow = shallowBase;
    deep = deepBase;
    shallow.z = shallowBase.z + depthShifts(s);
    deep.z = deepBase.z + depthShifts(s);
    shallowAll{s} = shallow;
    deepAll{s} = deep;

    [srcX1,srcY1,srcZ1,vol1] = prism_cells(shallow.x,shallow.y,shallow.z,shallow.n);
    [srcX2,srcY2,srcZ2,vol2] = prism_cells(deep.x,deep.y,deep.z,deep.n);
    srcX = [srcX1;srcX2];
    srcY = [srcY1;srcY2];
    srcZ = [srcZ1;srcZ2];
    cellVol = [repmat(vol1,numel(srcX1),1); repmat(vol2,numel(srcX2),1)];

    T = total_field_variable_cells(Xobs,Yobs,zObs,srcX,srcY,srcZ, ...
        cellVol,M,mHat,fHat,mu0_over_4pi);
    Ttop = total_field_variable_cells(Xobs,Yobs,zTop,srcX,srcY,srcZ, ...
        cellVol,M,mHat,fHat,mu0_over_4pi);
    Tbottom = total_field_variable_cells(Xobs,Yobs,zBottom,srcX,srcY,srcZ, ...
        cellVol,M,mHat,fHat,mu0_over_4pi);

    [dTdx,~] = gradient(T,dxObs,dyObs);
    dTdz = (Tbottom-Ttop)/(zBottom-zTop);
    [ISA,Theta,IAF] = operators_from_derivatives(dTdx,dTdz,epsilon);

    T_all{s} = T;
    ISA_all{s} = ISA;
    Theta_all{s} = Theta;
    IAF_all{s} = IAF;
end

%% 4. Contact localization: same criteria as Figures 3 V10 and 4
[~,iy0] = min(abs(yObs));
profileMethods = {ISA_all,Theta_all,IAF_all};
operatorNames = {'ISA','Theta','IAF'};

for op = 1:3
    for s = 1:nS
        prof = profileMethods{op}{s}(iy0,:);
        [p,ps] = detect_profile_peaks(xObs,prof,minPeakSeparation);
        allPeakPositions{op,s} = p;
        [matchedX,~] = match_peaks_tolerance(p,ps,trueContacts,associationTolerance);
        estimatedContacts(op,s,:) = matchedX;
        errs = abs(matchedX-trueContacts);
        contactErrors(op,s,:) = errs;
        matched = ~isnan(errs);
        detectionRates(op,s) = sum(matched)/numel(trueContacts);
        if any(matched)
            meanErrors(op,s) = mean(errs(matched));
        end
    end
end

%% 5. Figure 5A-C in one compact, publication-oriented layout
fig = figure('Color','w','Position',[40 40 1450 1140], ...
    'Name','IAF Figure 5 - Source depth');

% 5A: cross-section of the two bodies for each depth scenario.
% Preserve the true lateral positions; distinguish scenarios by line color/style.
axA = subplot(3,1,1);
hold(axA,'on'); box(axA,'on'); grid(axA,'on');
scenarioColors = {[0.00 0.45 0.74],[0.20 0.60 0.25],[0.85 0.33 0.10]};
scenarioStyles = {'-','--',':'};
for s = 1:nS
    sh = shallowAll{s}; dp = deepAll{s};
    rectangle(axA,'Position',[sh.x(1),sh.z(1),diff(sh.x),diff(sh.z)], ...
        'FaceColor','none','EdgeColor',scenarioColors{s}, ...
        'LineStyle',scenarioStyles{s},'LineWidth',1.8);
    rectangle(axA,'Position',[dp.x(1),dp.z(1),diff(dp.x),diff(dp.z)], ...
        'FaceColor','none','EdgeColor',scenarioColors{s}, ...
        'LineStyle',scenarioStyles{s},'LineWidth',1.8, ...
        'HandleVisibility','off');
end
set(axA,'YDir','reverse','FontName','Arial','FontSize',9);
xlabel(axA,'x (m)'); ylabel(axA,'Depth (m)');
title(axA,'5A. Synthetic model: vertical translation of both bodies');
xlim(axA,[-340 530]); ylim(axA,[0 500]);
% Explicit dummy line handles avoid an Octave legend() bug with rectangle objects.
hScenario = zeros(1,nS);
for s = 1:nS
    hScenario(s) = plot(axA,NaN,NaN,'Color',scenarioColors{s}, ...
        'LineStyle',scenarioStyles{s},'LineWidth',1.8);
end
legend(hScenario,scenarioNames,'Location','southoutside','Orientation','horizontal', ...
    'FontSize',8,'Box','on');
text(axA,0.015,0.93,'Surface z = 0 m','Units','normalized','FontSize',8, ...
    'VerticalAlignment','top','HorizontalAlignment','left','Clipping','on');

% 5B: central profiles, same axes per operator; no per-scenario normalization
profileColors = {[0.00 0.45 0.74],[0.20 0.60 0.25],[0.85 0.33 0.10]};
for op = 1:3
    ax = subplot(3,3,3+op); hold(ax,'on'); box(ax,'on'); grid(ax,'on');
    for s = 1:nS
        prof = profileMethods{op}{s}(iy0,:);
        plot(ax,xObs,prof,'Color',profileColors{s},'LineWidth',1.5, ...
            'DisplayName',scenarioNames{s});
    end
    xline_compat(ax,trueContacts);
    xlim(ax,[-500 500]);
    xlabel(ax,'x (m)'); ylabel(ax,[operatorNames{op} ' (rad)']);
    title(ax,sprintf('5B. %s profile (y = 0 m)',operatorNames{op}));
    if op == 1
        legend(ax,'Location','southoutside','Orientation','horizontal','FontSize',8,'Box','on');
    end
    set(ax,'FontName','Arial','FontSize',8);
end

% 5C: detection rate and conditional localization error
axD = subplot(3,3,7);
bar(axD,100*detectionRates');
set(axD,'XTick',1:nS,'XTickLabel',scenarioNames,'FontName','Arial','FontSize',8);
ylabel(axD,'Contacts detected (%)'); title(axD,'5C. Detection rate','FontSize',10);
legend(axD,operatorNames,'Location','southoutside','Orientation','horizontal','FontSize',8,'Box','on');
ylim(axD,[0 110]); grid(axD,'on'); box(axD,'on');

axE = subplot(3,3,8);
bar(axE,meanErrors');
set(axE,'XTick',1:nS,'XTickLabel',scenarioNames,'FontName','Arial','FontSize',8);
ylabel(axE,'Mean absolute error (m)');
title(axE,'Localization error among matched contacts','FontSize',10);
grid(axE,'on'); box(axE,'on');

% Compact exact-value panel: detection percentages and conditional MAE.
axN = subplot(3,3,9);
axis(axN,'off');
noteLines = {
    'Exact results'
    'Detection rate (%)'
    sprintf('ISA:   %g / %g / %g',100*detectionRates(1,1),100*detectionRates(1,2),100*detectionRates(1,3))
    sprintf('Theta: %g / %g / %g',100*detectionRates(2,1),100*detectionRates(2,2),100*detectionRates(2,3))
    sprintf('IAF:   %g / %g / %g',100*detectionRates(3,1),100*detectionRates(3,2),100*detectionRates(3,3))
    ''
    'MAE (m), matched contacts only'
    sprintf('ISA:   %.1f / %.1f / %.1f',meanErrors(1,1),meanErrors(1,2),meanErrors(1,3))
    sprintf('Theta: %.2f / %.2f / %.2f',meanErrors(2,1),meanErrors(2,2),meanErrors(2,3))
    sprintf('IAF:   %.1f / %.1f / %.1f',meanErrors(3,1),meanErrors(3,2),meanErrors(3,3))
    ''
    'Order: A reference / B +50 m / C +100 m'
    'Clean field; inclination 45°, declination 0°'
    'Peak separation ≥30 m; matching tolerance ±50 m'
    'Interpret MAE together with detection rate.'
    };
text(axN,0,1,noteLines,'VerticalAlignment','top','FontName','Arial','FontSize',8.5);
sgtitle_compat('Figure 5. Effect of source depth on angular operators');

print(fig,'IAF_Figura5_Profundidade.png','-dpng','-r300');

%% 6. Save all arrays and parameters for reproducibility
save('IAF_Figura5_Profundidade_Data.mat','xObs','yObs','dxObs','dyObs', ...
    'inclination','declination','M','mu0_over_4pi','epsilon','zTop','zObs','zBottom', ...
    'depthShifts','scenarioNames','shallowBase','deepBase','shallowAll','deepAll', ...
    'T_all','ISA_all','Theta_all','IAF_all','trueContacts','minPeakSeparation', ...
    'associationTolerance','estimatedContacts','contactErrors','detectionRates', ...
    'meanErrors','allPeakPositions');

fprintf('\nFIGURE 5: SOURCE-DEPTH EVALUATION\n');
fprintf('Clean fields; inclination = %g deg; declination = %g deg.\n',inclination,declination);
fprintf('True contacts (m): %s\n',mat2str(trueContacts));
for op = 1:3
    for s = 1:nS
        nMatched = round(detectionRates(op,s)*numel(trueContacts));
        fprintf('%s, %s: %d/4 contacts matched (%.0f%%); mean absolute error = ', ...
            operatorNames{op},scenarioNames{s},nMatched,100*detectionRates(op,s));
        if isnan(meanErrors(op,s))
            fprintf('undefined (no matched contacts)\n');
        else
            fprintf('%.2f m\n',meanErrors(op,s));
        end
        fprintf('  detected peaks (m): %s\n',mat2str(allPeakPositions{op,s}));
        fprintf('  matched estimates (m; NaN = missed): %s\n', ...
            mat2str(squeeze(estimatedContacts(op,s,:))'));
    end
end
fprintf('Interpret conditional localization error together with detection rate.\n');
fprintf('Exported: IAF_Figura5_Profundidade.png\n');
fprintf('Exported: IAF_Figura5_Profundidade_Data.mat\n');
end

function [ISA,Theta,IAF,ASA] = operators_from_derivatives(dTdx,dTdz,epsilon)
    ASA = hypot(dTdx,dTdz);
    ratio = dTdz./(ASA+epsilon);
    ratio = max(-1,min(1,ratio));
    ISA = atan(ratio);
    Theta = acos(ratio);
    IAF = (ISA+Theta)./2;
end

function [srcX,srcY,srcZ,cellVol] = prism_cells(xLim,yLim,zLim,n)
    xEdges = linspace(xLim(1),xLim(2),n(1)+1);
    yEdges = linspace(yLim(1),yLim(2),n(2)+1);
    zEdges = linspace(zLim(1),zLim(2),n(3)+1);
    xc = (xEdges(1:end-1)+xEdges(2:end))/2;
    yc = (yEdges(1:end-1)+yEdges(2:end))/2;
    zc = (zEdges(1:end-1)+zEdges(2:end))/2;
    [VX,VY,VZ] = ndgrid(xc,yc,zc);
    srcX = VX(:); srcY = VY(:); srcZ = VZ(:);
    cellVol = ((xLim(2)-xLim(1))/n(1))* ...
              ((yLim(2)-yLim(1))/n(2))* ...
              ((zLim(2)-zLim(1))/n(3));
end

function TnT = total_field_variable_cells(X,Y,zObs,srcX,srcY,srcZ,cellVol,M,mHat,fHat,mu0_over_4pi)
    Bx = zeros(size(X)); By = zeros(size(X)); Bz = zeros(size(X));
    for k = 1:numel(srcX)
        moment = M*cellVol(k)*mHat;
        rx = X-srcX(k); ry = Y-srcY(k); rz = zObs-srcZ(k);
        r2 = rx.^2+ry.^2+rz.^2;
        r = sqrt(r2); r3 = r2.*r; r5 = r3.*r2;
        mdotr = moment(1).*rx+moment(2).*ry+moment(3).*rz;
        Bx = Bx+mu0_over_4pi*(3.*rx.*mdotr./r5-moment(1)./r3);
        By = By+mu0_over_4pi*(3.*ry.*mdotr./r5-moment(2)./r3);
        Bz = Bz+mu0_over_4pi*(3.*rz.*mdotr./r5-moment(3)./r3);
    end
    TnT = (fHat(1).*Bx+fHat(2).*By+fHat(3).*Bz)*1e9;
end

function [peakX,peakStrength] = detect_profile_peaks(x,profile,minSeparation)
    dx = x(2)-x(1);
    strength = abs(gradient(profile,dx));
    idx = [];
    for i = 2:numel(strength)-1
        if strength(i) >= strength(i-1) && strength(i) > strength(i+1)
            idx(end+1) = i; %#ok<AGROW>
        end
    end
    if isempty(idx)
        peakX = []; peakStrength = []; return;
    end
    [~,order] = sort(strength(idx),'descend');
    chosen = [];
    for j = 1:numel(order)
        candidate = idx(order(j));
        if isempty(chosen) || all(abs(x(candidate)-x(chosen)) >= minSeparation)
            chosen(end+1) = candidate; %#ok<AGROW>
        end
    end
    chosen = sort(chosen);
    peakX = x(chosen);
    peakStrength = strength(chosen);
end

function [matchedX,matchedS] = match_peaks_tolerance(peakX,peakS,trueContacts,tolerance)
    n = numel(peakX); m = numel(trueContacts);
    matchedX = NaN(1,m); matchedS = NaN(1,m);
    usedPeaks = false(1,n);
    currentX = NaN(1,m); currentS = NaN(1,m);
    [matchedX,matchedS,~,~] = search_matches(1,peakX,peakS,trueContacts, ...
        tolerance,usedPeaks,currentX,currentS,0,0,matchedX,matchedS,-1,Inf);
end

function [bestX,bestS,bestCount,bestDistance] = search_matches( ...
    contactIdx,peakX,peakS,trueContacts,tolerance,usedPeaks,currentX,currentS, ...
    currentCount,currentDistance,bestX,bestS,bestCount,bestDistance)
    m = numel(trueContacts); n = numel(peakX);
    if contactIdx > m
        if currentCount > bestCount || ...
           (currentCount == bestCount && currentDistance < bestDistance)
            bestX = currentX; bestS = currentS;
            bestCount = currentCount; bestDistance = currentDistance;
        end
        return;
    end
    [bestX,bestS,bestCount,bestDistance] = search_matches( ...
        contactIdx+1,peakX,peakS,trueContacts,tolerance,usedPeaks, ...
        currentX,currentS,currentCount,currentDistance,bestX,bestS,bestCount,bestDistance);
    for i = 1:n
        d = abs(peakX(i)-trueContacts(contactIdx));
        if ~usedPeaks(i) && d <= tolerance
            nextUsed = usedPeaks; nextUsed(i) = true;
            nextX = currentX; nextS = currentS;
            nextX(contactIdx) = peakX(i); nextS(contactIdx) = peakS(i);
            [bestX,bestS,bestCount,bestDistance] = search_matches( ...
                contactIdx+1,peakX,peakS,trueContacts,tolerance,nextUsed, ...
                nextX,nextS,currentCount+1,currentDistance+d, ...
                bestX,bestS,bestCount,bestDistance);
        end
    end
end

function xline_compat(ax,bounds)
    yl = ylim(ax);
    for k = 1:numel(bounds)
        plot(ax,[bounds(k) bounds(k)],yl,'k--','LineWidth',0.7,'HandleVisibility','off');
    end
    ylim(ax,yl);
end

function sgtitle_compat(txt)
    % sgtitle exists in recent MATLAB and GNU Octave; fallback uses annotation.
    if exist('sgtitle','file') || exist('sgtitle','builtin')
        sgtitle(txt,'FontWeight','bold','FontSize',13);
    else
        annotation(gcf,'textbox',[0.1 0.965 0.8 0.025],'String',txt, ...
            'EdgeColor','none','HorizontalAlignment','center','FontWeight','bold','FontSize',13);
    end
end
